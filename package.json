{
  "name": "web-sandbox",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && npm run build:server",
    "build:server": "tsc -p tsconfig.server.json",
    "dev:server": "tsx watch server/index.ts",
    "start": "node .server-dist/server/index.js",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "vitest run"
  },
  "dependencies": {
    "@fastify/static": "10.1.8",
    "@solaria.network/web-lib": "^0.5.0",
    "@thesvg/react": "^3.4.1",
    "fastify": "5.12.7",
    "i18next": "^26.5.2",
    "jose": "6.2.13",
    "lucide-react": "^1.59.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-i18next": "^17.1.0",
    "react-icons": "^5.7.0",
    "react-router-dom": "^7.18.4",
    "react-speech-recognition": "^4.0.1",
    "swagger-ui-dist": "5.33.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@types/react-speech-recognition": "^3.9.6",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.6",
    "globals": "^17.12.0",
    "jsdom": "^25.0.1",
    "tailwindcss": "^4.3.3",
    "tsx": "4.23.15",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.71.2",
    "vite": "^8.3.0",
    "vitest": "^4.1.12"
  }
