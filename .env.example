VITE_API_MESSENGER=https://api-messenger-5g2n.onrender.com
VITE_API_RECOMMENDATION=https://api-recommendation-qlml.onrender.com
VITE_AI_ASSISTANT=https://ai-assistant-5ljd.onrender.com
VITE_AI_GEOGRAPHIC=https://ai-geographic.onrender.com
VITE_AI_OPERATIONAL=https://ai-operational.onrender.com
VITE_AI_ACCESSIBILITY=https://ai-accessibility.onrender.com
VITE_AI_VALIDATION=https://ai-validation-jjb7.onrender.com
VITE_API_EMAIL=https://api-email-6swz.onrender.com
# URLs completas das interfaces publicadas do api-email; ausência mantém o ícone desabilitado.
VITE_QA_API_EMAIL_SWAGGER=
VITE_PROD_API_EMAIL_SWAGGER=
VITE_QA_API_EMAIL_MAILPIT=
VITE_PROD_API_EMAIL_MAILPIT=
VITE_EMAIL_GALLERY=https://solierrr.github.io/api-email/
VITE_GOOGLE_REGISTRY=https://google-registry.onrender.com
# ALWAYS pula a autenticação (login aceita qualquer e-mail e senha) só no modo de desenvolvimento; DEACTIVATED usa a API-auth de QA.
VITE_MOCKS=ALWAYS

# O portal real exige VITE_MOCKS=DEACTIVATED e npm run dev:server.
# Segredos são injetados somente no processo do servidor, via Infisical QA.
# Nunca crie variáveis VITE_ para service keys.
# JWT_ISSUER=solaria-auth
# PORT=5180
